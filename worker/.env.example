# Cấu hình Mock Worker — sao chép thành .env và điều chỉnh

# URL của Spring Boot backend
BACKEND_URL=http://localhost:8080

# Secret key phải khớp với WORKER_SECRET_KEY trong backend .env
WORKER_SECRET_KEY=worker-secret-local

# (Tuỳ chọn) Tên định danh worker instance
# WORKER_INSTANCE_ID=mock-worker-dev

# (Tuỳ chọn) Thời gian chờ giữa 2 lần poll khi không có job (giây)
# POLL_INTERVAL_SECONDS=2

# (Tuỳ chọn) Thời gian "giả lập AI xử lý" mỗi job (giây)
# MOCK_PROCESSING_SECONDS=5

# (Tuỳ chọn) Chu kỳ gửi heartbeat (giây)
# HEARTBEAT_INTERVAL_SECONDS=20
