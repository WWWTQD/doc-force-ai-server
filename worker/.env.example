# Cấu hình Mock Worker — sao chép thành .env và điều chỉnh

# URL của Spring Boot backend
BACKEND_URL=http://localhost:8080

# Secret key phải khớp với WORKER_SECRET_KEY trong backend .env
WORKER_SECRET_KEY=worker-secret-local

# (Tuỳ chọn) Tên định danh worker instance
# WORKER_INSTANCE_ID=mock-worker-dev

# (Tuỳ chọn) Thời gian chờ giữa 2 lần poll khi không có job (giây)
# POLL_INTERVAL_SECONDS=2

# (Tuỳ chọn) Thời gian "giả lập AI xử lý" mỗi job (giây)
# MOCK_PROCESSING_SECONDS=5

# (Tuỳ chọn) Chu kỳ gửi heartbeat (giây)
# HEARTBEAT_INTERVAL_SECONDS=20

# Normalizer & Stage hậu xử lý LLM_POSTPROCESS (mặc định TẮT an toàn)
LEGACY_DOMAIN_RULES=false
LLM_POSTPROCESS_ENABLED=false
LLM_POSTPROCESS_DEFAULT=false
LLM_PROVIDER=mock
LLM_MOCK_MODE=normal
LLM_LINE_CONF_THRESHOLD=0.90
LLM_MAX_CANDIDATES_PER_PAGE=30
LLM_MAX_INVALID_TOKEN_RATIO=0.5
LLM_REOCR_ENABLED=false
MAX_REOCR_LINES_PER_PAGE=15
ALLOW_COMMON_LOANWORDS=true
LLM_PAGE_DEADLINE_SECONDS=15
LLM_MAX_VLM_CROPS=5
LLM_MODEL=gemini-3.8-flash
LLM_TEXT_MODEL=gemini-3.8-flash
LLM_VISION_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_ON_UNAVAILABLE=false
LLM_THINKING_LEVEL=minimal
LLM_RPM_LIMIT=5
LLM_DAILY_REQUEST_BUDGET=150
LLM_CLOUD_CONSENT=false
LLM_CLOUD_TIER=free
LLM_REQUEST_TIMEOUT_SECONDS=10.0
# GEMINI_API_KEY=  (đặt qua biến môi trường khi chạy thật; KHÔNG lưu khóa trong repo)

