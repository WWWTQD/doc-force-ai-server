APP_NAME=doc-force-ai-server
APP_VERSION=1.0.0
DEBUG=true
MAX_FILE_SIZE_MB=10
BLUR_THRESHOLD=100.0
LOW_BRIGHTNESS_THRESHOLD=60
HIGH_BRIGHTNESS_THRESHOLD=200
OCR_LANGUAGE=eng
OUTPUT_DIR=data/output
CORS_ORIGINS=["http://localhost:3000"]

# Normalizer & Optional LLM_POSTPROCESS stage (mac dinh TAT)
LEGACY_DOMAIN_RULES=false
LLM_POSTPROCESS_ENABLED=false
LLM_POSTPROCESS_DEFAULT=false
LLM_PROVIDER=mock
LLM_MOCK_MODE=normal
LLM_LINE_CONF_THRESHOLD=0.90
LLM_MAX_CANDIDATES_PER_PAGE=30
LLM_MAX_INVALID_TOKEN_RATIO=0.5
LLM_REOCR_ENABLED=false
MAX_REOCR_LINES_PER_PAGE=15
ALLOW_COMMON_LOANWORDS=true
LLM_PAGE_DEADLINE_SECONDS=15
LLM_MAX_VLM_CROPS=0
LLM_MODEL=gemini-3.5-flash
LLM_TEXT_MODEL=gemini-3.5-flash
LLM_VISION_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_ON_UNAVAILABLE=false
LLM_THINKING_LEVEL=minimal
LLM_RPM_LIMIT=5
LLM_DAILY_REQUEST_BUDGET=150
LLM_CLOUD_CONSENT=false
LLM_CLOUD_TIER=free
LLM_REQUEST_TIMEOUT_SECONDS=10.0
# GEMINI_API_KEY=  (dat qua bien moi truong khi chay that; KHONG luu khoa trong repo)

